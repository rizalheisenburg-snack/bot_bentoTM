# Copy file ini jadi ".env.printagent-wifi" di folder yang sama dengan
# print_agent_wifi.py.

# WAJIB pake dev_server.py lokal dulu selama masih eksperimen — JANGAN
# arahin ke wss://app.bentotm.cloud/ws/printer (production), soalnya
# server cuma nerima 1 print-agent aktif dan bakal nendang keluar agent
# USB yang lagi jalan beneran.
PRINT_SERVER_WS_URL=ws://127.0.0.1:8080/ws/printer

# Harus sama persis dengan PRINTER_AGENT_TOKEN di .env server yang lagi dipake
# (kalau tes lokal, itu .env utama proyek ini).
PRINT_AGENT_TOKEN=ganti-sesuai-token-server-yang-lagi-dites

# IP printer di jaringan WiFi — cek DHCP client list router, cari MAC
# DC-0D-30-82-35-33 (dari self-test print) atau nama device APOSP80A.
PRINTER_IP=192.168.1.XXX
PRINTER_PORT=9100