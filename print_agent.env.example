# Copy file ini jadi ".env" di folder yang sama dengan print_agent.py
# (PC lokal yang nyolok printer), isi sesuai server VPS-nya.

# URL WebSocket server, path /ws/printer. Pakai wss:// kalau server sudah HTTPS.
PRINT_SERVER_WS_URL=wss://domain-vps-lo.com/ws/printer

# Harus sama persis dengan PRINTER_AGENT_TOKEN di .env server (VPS).
PRINT_AGENT_TOKEN=ganti-dengan-secret-acak-yang-panjang

# USB VID/PID printer. Default sudah sesuai APOS-P80A-BW, biasanya gak perlu diubah.
PRINTER_VID=0x0FE6
PRINTER_PID=0x811E
